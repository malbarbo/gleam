----- SOURCE CODE
-- wibble.gleam

pub type Wibble {
  Wibble(Int)
}

pub const one = Wibble(1)


-- wobble.gleam

import wibble

pub const wobble = wibble.one


-- main.gleam
import wobble.{wobble}

pub fn main() {
  case wobble {
    x if x == wobble -> "eq"
    _ -> "ne"
  }
}


----- COMPILED JAVASCRIPT
import { isEqual } from "../gleam.mjs";
import * as $wibble from "../wibble.mjs";
import * as $wobble from "../wobble.mjs";
import { wobble } from "../wobble.mjs";

export function main() {
  let $ = wobble;
  let x = $;
  if (isEqual(x, new $wibble.Wibble(1))) {
    return "eq";
  } else {
    return "ne";
  }
}
