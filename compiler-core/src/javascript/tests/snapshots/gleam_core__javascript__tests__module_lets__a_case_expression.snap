pub let x = case 1 {
  1 -> "a"
  _ -> "b"
}


----- COMPILED JAVASCRIPT
export const x = (() => {
  let $ = 1;
  if ($ === 1) {
    return "a";
  } else {
    return "b";
  }
})();
