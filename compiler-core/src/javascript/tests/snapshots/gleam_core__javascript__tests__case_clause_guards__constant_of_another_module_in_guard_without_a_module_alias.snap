----- SOURCE CODE
-- wibble.gleam

pub type Wibble {
  Wibble(Int)
}

pub const wibble = Wibble(1)


-- main.gleam
import wibble.{wibble} as _

pub fn main() {
  case wibble {
    x if x == wibble -> "eq"
    _ -> "ne"
  }
}


----- COMPILED JAVASCRIPT
import { isEqual } from "../gleam.mjs";
import * as $wibble from "../wibble.mjs";
import { wibble } from "../wibble.mjs";

export function main() {
  let $ = wibble;
  let x = $;
  if (isEqual(x, new $wibble.Wibble(1))) {
    return "eq";
  } else {
    return "ne";
  }
}
