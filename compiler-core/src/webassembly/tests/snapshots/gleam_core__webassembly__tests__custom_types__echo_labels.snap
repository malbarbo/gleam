----- SOURCE CODE

pub type Point {
    Point(x: Int, y: Float)
}

pub type Shape {
    Empty(unit: Nil)
    Circle(Int, radius: Int)
    Square(side: Int)
}

pub fn main() {
    echo Point(1, 2.0)
    echo Empty(Nil)
    echo Circle(1, 2)
    echo Square(3)
}


