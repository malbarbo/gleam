----- SOURCE CODE

fn inc(x: Int) -> Int {
    x + 1
}

pub fn main() {
    let n = 1
    let f = fn(x: Int) { x + n }
    let y = 1 |> echo
    let z = y |> echo |> inc |> echo as "inc"
    let g = f |> echo
    assert g(z) == 3
}


