----- SOURCE CODE

pub type N(a) {
  Flat(a)
  Nest(N(#(a, a)))
}

pub fn build(n: Int, x: a) -> N(a) {
  case n {
    0 -> Flat(x)
    _ -> Nest(helper(n, x))
  }
}

fn helper(n: Int, x: b) -> N(#(b, b)) {
  build(n - 1, #(x, x))
}

pub fn main() {
  build(3, 1)
}


