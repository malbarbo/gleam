/// Hashes any value, consistently with `==`. On WebAssembly this is the
/// `_hash` builtin, generated by the compiler for each type.
@external(erlang, "erlang", "phash2")
@external(webassembly, "builtins", "_hash")
pub fn hash(value: a) -> Int

/// Keeps the low 32 bits. `Int` may have 32 bits, so the mask is computed:
/// a shift by the width of `Int` gives 0, and then the mask has all bits.
pub fn low_32_bits(value: Int) -> Int {
  bitwise_and(value, bitwise_shift_left(1, 32) - 1)
}

/// The `string.inspect` text of any value. Not imported from `gleam/string`,
/// which depends on `gleam/dict` through `gleam/list`.
@external(webassembly, "builtins", "_inspect")
pub fn inspect(value: a) -> String {
  repr_to_string(do_inspect(value))
}

type Repr

@external(erlang, "gleam_stdlib", "inspect")
fn do_inspect(value: a) -> Repr

@external(erlang, "unicode", "characters_to_binary")
fn repr_to_string(repr: Repr) -> String

@external(erlang, "erlang", "list_to_binary")
@external(webassembly, "builtins", "_string_concat_list")
pub fn concat_strings(strings: List(String)) -> String

@external(erlang, "erlang", "byte_size")
@external(webassembly, "builtins", "_string_byte_size")
pub fn string_byte_size(string: String) -> Int

pub fn reverse_and_prepend(list: List(a), to suffix: List(a)) -> List(a) {
  case list {
    [] -> suffix
    [first, ..rest] -> reverse_and_prepend(rest, [first, ..suffix])
  }
}

@external(erlang, "erlang", "band")
@external(webassembly, "builtins", "_int_bitwise_and")
pub fn bitwise_and(a: Int, b: Int) -> Int

@external(erlang, "erlang", "bor")
@external(webassembly, "builtins", "_int_bitwise_or")
pub fn bitwise_or(a: Int, b: Int) -> Int

@external(erlang, "erlang", "bxor")
@external(webassembly, "builtins", "_int_bitwise_exclusive_or")
pub fn bitwise_exclusive_or(a: Int, b: Int) -> Int

@external(erlang, "erlang", "bsl")
@external(webassembly, "builtins", "_int_bitwise_shift_left")
pub fn bitwise_shift_left(a: Int, b: Int) -> Int

@external(erlang, "erlang", "bsr")
@external(webassembly, "builtins", "_int_bitwise_shift_right")
pub fn bitwise_shift_right(a: Int, b: Int) -> Int
