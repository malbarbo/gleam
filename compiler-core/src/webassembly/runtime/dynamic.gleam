//// The `Dynamic` that the WebAssembly target provides to
//// `@external(webassembly, "builtins", "Dynamic")`. Its public functions are
//// reached with `@external(webassembly, "builtins", "dynamic_...")`.
////
//// WebAssembly has no runtime type information that generic code could use
//// to inspect any value, so `Dynamic` is a closed sum. Ints, floats, strings,
//// booleans, `Nil`, bit arrays, codepoints, lists, tuples (as arrays) and
//// dicts have their own variants; any other value is boxed in `DOther`,
//// together with a table of functions generated for its type.
////
//// `_dynamic_cast`, which turns a value of any type into a `Dynamic`, needs
//// the static type of the value, so the compiler generates it for each type,
//// with the constructors of this module. The other functions don't need it.
////
//// It also compiles on Erlang, where `DOther` is never built.

// SPDX-License-Identifier: Apache-2.0
// SPDX-FileCopyrightText: 2026 The Gleam contributors

import builtins/array.{
  type Array, array_from_list, array_get, array_size, array_to_list,
}
import builtins/base.{
  bitwise_exclusive_or, hash, inspect, low_32_bits, reverse_and_prepend,
}
import builtins/bit_array.{type Bits, bit_array_from_string}
import builtins/dict.{type Dict}

pub type Dynamic {
  DInt(Int)
  DFloat(Float)
  DString(String)
  DBool(Bool)
  DNil
  DBitArray(Bits)
  /// A codepoint, which is an `Int` for `decode`, `==` and `hash`, as on
  /// Erlang.
  DUtfCodepoint(UtfCodepoint)
  DList(List(Dynamic))
  /// A tuple, an `Array`, or a list made with `dynamic.array`.
  DArray(Array(Dynamic))
  DDict(Dict(Dynamic, Dynamic))
  /// Any other value. `vtable` is generated by the compiler for the type of
  /// `value`.
  DOther(value: AnyRef, vtable: VTable)
}

/// A value of any type (an `anyref`).
@external(webassembly, "builtins", "AnyRef")
pub type AnyRef

/// Functions generated by the compiler for one type `T`, which cast the
/// `AnyRef` to `T`. Two values of the same type have tables with the same
/// `name`. `fields` gives the fields that `decode.dict` and `decode.field`
/// read, which only a value of the host has (see `dynamic_no_fields`).
/// `view` opens one level of the value, see `dynamic_view`.
pub type VTable {
  VTable(
    name: String,
    classify: String,
    equal: fn(AnyRef, AnyRef) -> Bool,
    hash: fn(AnyRef) -> Int,
    inspect: fn(AnyRef) -> String,
    fields: fn(AnyRef) -> Result(Dict(Dynamic, Dynamic), Nil),
    view: fn(AnyRef) -> Reflection,
  )
}

/// One level of a value in `DOther`. A label is `""` for a field without
/// one.
pub type Reflection {
  RRecord(
    module: String,
    name: String,
    constructor: String,
    labels: Array(String),
    fields: Array(Dynamic),
    is_opaque: Bool,
  )
  RFunction(arity: Int)
  RExternal(module: String, name: String)
}

// -- Constructors -------------------------------------------------------------

pub fn dynamic_bool(value: Bool) -> Dynamic {
  DBool(value)
}

pub fn dynamic_string(value: String) -> Dynamic {
  DString(value)
}

pub fn dynamic_float(value: Float) -> Dynamic {
  DFloat(value)
}

pub fn dynamic_int(value: Int) -> Dynamic {
  DInt(value)
}

pub fn dynamic_nil() -> Dynamic {
  DNil
}

pub fn dynamic_bit_array(value: Bits) -> Dynamic {
  DBitArray(value)
}

pub fn dynamic_utf_codepoint(value: UtfCodepoint) -> Dynamic {
  DUtfCodepoint(value)
}

pub fn dynamic_list(value: List(Dynamic)) -> Dynamic {
  DList(value)
}

pub fn dynamic_array(value: List(Dynamic)) -> Dynamic {
  DArray(array_from_list(value))
}

pub fn dynamic_dict(value: Dict(Dynamic, Dynamic)) -> Dynamic {
  DDict(value)
}

/// Used by `_dynamic_cast` for the lists of other types than `Dynamic`.
pub fn dynamic_list_with(list: List(a), cast: fn(a) -> Dynamic) -> Dynamic {
  DList(map(list, cast, []))
}

/// Used by `_dynamic_cast` for the dicts of other types than `Dynamic`.
pub fn dynamic_dict_with(
  dict: Dict(k, v),
  cast_key: fn(k) -> Dynamic,
  cast_value: fn(v) -> Dynamic,
) -> Dynamic {
  DDict(
    dict.dict_fold(dict, dict.dict_new(), fn(acc, key, value) {
      dict.dict_insert(acc, cast_key(key), cast_value(value))
    }),
  )
}

/// Used by `_dynamic_cast` for tuples and arrays, whose cast elements it puts
/// in an array.
pub fn dynamic_from_array(value: Array(Dynamic)) -> Dynamic {
  DArray(value)
}

/// Used by `_dynamic_cast` for the other types.
pub fn dynamic_other(
  value: AnyRef,
  name: String,
  classify: String,
  equal: fn(AnyRef, AnyRef) -> Bool,
  hash: fn(AnyRef) -> Int,
  inspect: fn(AnyRef) -> String,
  fields: fn(AnyRef) -> Result(Dict(Dynamic, Dynamic), Nil),
  view: fn(AnyRef) -> Reflection,
) -> Dynamic {
  DOther(
    value,
    VTable(name:, classify:, equal:, hash:, inspect:, fields:, view:),
  )
}

/// Used by the `view` of a table for a value of a custom type.
pub fn dynamic_record(
  module: String,
  name: String,
  constructor: String,
  labels: Array(String),
  fields: Array(Dynamic),
  is_opaque: Bool,
) -> Reflection {
  RRecord(module:, name:, constructor:, labels:, fields:, is_opaque:)
}

/// Used by the `view` of a table for a function.
pub fn dynamic_function(arity: Int) -> Reflection {
  RFunction(arity)
}

/// Used by the `view` of a table for a value without constructors.
pub fn dynamic_external(module: String, name: String) -> Reflection {
  RExternal(module, name)
}

/// The `fields` of the values that have none.
pub fn dynamic_no_fields(_value: AnyRef) -> Result(Dict(Dynamic, Dynamic), Nil) {
  Error(Nil)
}

// -- Queries ------------------------------------------------------------------

/// The names used on Erlang and JavaScript, and for a value of another type,
/// the name used on JavaScript.
pub fn dynamic_classify(data: Dynamic) -> String {
  case data {
    DInt(_) -> "Int"
    DFloat(_) -> "Float"
    DString(_) -> "String"
    DBool(_) -> "Bool"
    DNil -> "Nil"
    DBitArray(_) -> "BitArray"
    DUtfCodepoint(_) -> "Int"
    DList(_) -> "List"
    DArray(_) -> "Array"
    DDict(_) -> "Dict"
    DOther(vtable:, ..) -> vtable.classify
  }
}

pub fn dynamic_is_null(data: Dynamic) -> Bool {
  case data {
    DNil -> True
    _ -> False
  }
}

pub fn dynamic_decode_int(data: Dynamic) -> Result(Int, Int) {
  case data {
    DInt(value) -> Ok(value)
    DUtfCodepoint(value) -> Ok(utf_codepoint_to_int(value))
    _ -> Error(0)
  }
}

pub fn dynamic_decode_float(data: Dynamic) -> Result(Float, Float) {
  case data {
    DFloat(value) -> Ok(value)
    _ -> Error(0.0)
  }
}

pub fn dynamic_decode_string(data: Dynamic) -> Result(String, String) {
  case data {
    DString(value) -> Ok(value)
    _ -> Error("")
  }
}

pub fn dynamic_decode_bit_array(data: Dynamic) -> Result(Bits, Bits) {
  case data {
    DBitArray(value) -> Ok(value)
    _ -> Error(bit_array_from_string(""))
  }
}

/// The items of lists and arrays.
pub fn dynamic_decode_list_items(data: Dynamic) -> Result(List(Dynamic), Nil) {
  case data {
    DList(items) -> Ok(items)
    DArray(items) -> Ok(array_to_list(items))
    _ -> Error(Nil)
  }
}

pub fn dynamic_decode_dict(
  data: Dynamic,
) -> Result(Dict(Dynamic, Dynamic), Nil) {
  case data {
    DDict(dict) -> Ok(dict)
    DOther(value, vtable) -> vtable.fields(value)
    _ -> Error(Nil)
  }
}

/// The value at `key`, with the semantics of `index` on Erlang: `Ok(Ok(_))`
/// when found, `Ok(Error(Nil))` when `data` can be indexed by `key` but has
/// nothing there, and `Error` with the expected kind otherwise.
pub fn dynamic_index(
  data: Dynamic,
  key: Dynamic,
) -> Result(Result(Dynamic, Nil), String) {
  case data, key {
    DDict(dict), _ -> Ok(dict.dict_get(dict, key))
    DOther(value, vtable), _ ->
      case vtable.fields(value), key {
        Ok(fields), _ -> Ok(dict.dict_get(fields, key))
        Error(Nil), DInt(_) -> Error("Indexable")
        Error(Nil), _ -> Error("Dict")
      }
    DList(items), DInt(index) if index >= 0 && index < 8 ->
      case at(items, index) {
        Ok(item) -> Ok(Ok(item))
        Error(Nil) -> Error("Indexable")
      }
    DArray(items), DInt(index) ->
      case index >= 0 && index < array_size(items) {
        True -> Ok(Ok(array_get(items, index)))
        False -> Ok(Error(Nil))
      }
    _, DInt(_) -> Error("Indexable")
    _, _ -> Error("Dict")
  }
}

fn at(items: List(a), index: Int) -> Result(a, Nil) {
  case items {
    [] -> Error(Nil)
    [item, ..] if index == 0 -> Ok(item)
    [_, ..rest] if index > 0 -> at(rest, index - 1)
    _ -> Error(Nil)
  }
}

/// Opens one level of `data`, calling the function for its kind. The
/// standard library passes the constructors of its type, which the runtime
/// cannot name. A list gives its first item and the rest, and a dict gives
/// its first entry in the order of `dict_first` and the rest.
pub fn dynamic_view(
  data: Dynamic,
  int: fn(Int) -> v,
  float: fn(Float) -> v,
  string: fn(String) -> v,
  bool: fn(Bool) -> v,
  nil: v,
  bit_array: fn(Bits) -> v,
  utf_codepoint: fn(UtfCodepoint) -> v,
  tuple: fn(List(Dynamic)) -> v,
  empty: v,
  cons: fn(Dynamic, Dynamic) -> v,
  empty_dict: v,
  entry: fn(Dynamic, Dynamic, Dynamic) -> v,
  record: fn(String, String, String, List(String), List(Dynamic), Bool) -> v,
  function: fn(Int) -> v,
  external: fn(String, String) -> v,
) -> v {
  case data {
    DInt(x) -> int(x)
    DFloat(x) -> float(x)
    DString(x) -> string(x)
    DBool(x) -> bool(x)
    DNil -> nil
    DBitArray(x) -> bit_array(x)
    DUtfCodepoint(x) -> utf_codepoint(x)
    DArray(items) -> tuple(array_to_list(items))
    DList([]) -> empty
    DList([first, ..rest]) -> cons(first, DList(rest))
    DDict(x) ->
      case dict.dict_pop_first(x) {
        Ok(#(key, value, rest)) -> entry(key, value, DDict(rest))
        Error(Nil) -> empty_dict
      }
    DOther(x, vtable) ->
      case vtable.view(x) {
        RRecord(module:, name:, constructor:, labels:, fields:, is_opaque:) ->
          record(
            module,
            name,
            constructor,
            array_to_list(labels),
            array_to_list(fields),
            is_opaque,
          )
        RFunction(arity) -> function(arity)
        RExternal(module, name) -> external(module, name)
      }
  }
}

// -- Type hooks ---------------------------------------------------------------

/// Structural equality on the variants. Two `DOther` values are equal when
/// they have the same type and its `equal` says so, and a `DOther` with
/// `fields`, a plain object of the host, is equal to the dict of its fields.
pub fn dynamic_equal(a: Dynamic, b: Dynamic) -> Bool {
  case a, b {
    DInt(x), DInt(y) -> x == y
    DFloat(x), DFloat(y) -> x == y
    DString(x), DString(y) -> x == y
    DBool(x), DBool(y) -> x == y
    DNil, DNil -> True
    DBitArray(x), DBitArray(y) -> x == y
    DUtfCodepoint(x), DUtfCodepoint(y) -> x == y
    DUtfCodepoint(x), DInt(y) | DInt(y), DUtfCodepoint(x) ->
      utf_codepoint_to_int(x) == y
    DList(xs), DList(ys) -> xs == ys
    DArray(xs), DArray(ys) -> xs == ys
    DDict(x), DDict(y) -> x == y
    DOther(x, vx), DOther(y, vy) -> vx.name == vy.name && vx.equal(x, y)
    DOther(x, vx), DDict(d) | DDict(d), DOther(x, vx) -> vx.fields(x) == Ok(d)
    _, _ -> False
  }
}

/// A hash consistent with `dynamic_equal`.
pub fn dynamic_hash(value: Dynamic) -> Int {
  case value {
    DInt(x) -> mix(1, hash(x))
    DFloat(x) -> mix(2, hash(x))
    DString(x) -> mix(3, hash(x))
    DBool(x) -> mix(4, hash(x))
    DNil -> 5
    DBitArray(x) -> mix(10, hash(x))
    DUtfCodepoint(x) -> mix(1, hash(utf_codepoint_to_int(x)))
    DList(xs) -> mix(6, hash(xs))
    DArray(xs) -> mix(7, hash(xs))
    DDict(x) -> mix(8, hash(x))
    DOther(x, vtable) ->
      case vtable.fields(x) {
        Ok(fields) -> mix(8, hash(fields))
        Error(Nil) -> mix(9, vtable.hash(x))
      }
  }
}

/// Combines two hashes, keeping the result in 32 bits.
fn mix(a: Int, b: Int) -> Int {
  low_32_bits(bitwise_exclusive_or(a * 31, b))
}

/// The text of the value inside, as `string.inspect` shows it.
pub fn dynamic_inspect(value: Dynamic) -> String {
  case value {
    DInt(x) -> inspect(x)
    DFloat(x) -> inspect(x)
    DString(x) -> inspect(x)
    DBool(x) -> inspect(x)
    DNil -> "Nil"
    DBitArray(x) -> inspect(x)
    DUtfCodepoint(x) -> inspect(x)
    DList(xs) -> inspect(xs)
    DArray(xs) -> inspect(xs)
    DDict(x) -> inspect(x)
    DOther(x, vtable) -> vtable.inspect(x)
  }
}

@external(erlang, "gleam_stdlib", "identity")
@external(webassembly, "builtins", "_utf_codepoint_to_int")
fn utf_codepoint_to_int(value: UtfCodepoint) -> Int

// -- Lists --------------------------------------------------------------------

fn map(list: List(a), fun: fn(a) -> b, acc: List(b)) -> List(b) {
  case list {
    [] -> reverse_and_prepend(acc, [])
    [item, ..rest] -> map(rest, fun, [fun(item), ..acc])
  }
}
